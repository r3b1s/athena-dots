#!/bin/sh
# Set a random wallpaper from ~/.config/wallpapers (override with the first
# argument). Run by i3 via exec_always, so $mod+Shift+r (i3-msg reload) picks a
# new one. It must never fail the reload, and it should always say what it did:
# with a single image, or an empty folder, silence would look like a dead key.
#
# Usage:
#   x11-wallpaper [DIR]     unset the root window, then fill it with a random image
#   x11-wallpaper --reset   unset only (solid theme background)
#
# The unset matters. Re-running feh over an image that is already the wallpaper
# is invisible when the image is unchanged, so the key looks broken. Clearing to
# a solid colour first guarantees a visible transition, and clears the tiling
# that a stale root-window image leaves behind.
set -u

# pinkrot background, so the gap during a reset is the theme's, not black.
COLOR="#050007"

reset_root() {
    command -v xsetroot >/dev/null || return 0
    xsetroot -solid "$COLOR" 2>/dev/null
}

case "${1:-}" in
    --reset)
        reset_root
        exit 0
        ;;
esac

dir="${1:-${XDG_CONFIG_HOME:-$HOME/.config}/wallpapers}"
urgency="low"
timeout=5

notify() {
    command -v dunstify >/dev/null || return 0
    dunstify -a athena-dots -u "$urgency" -t "$timeout" "Wallpaper" "$1"
}

if [ ! -d "$dir" ]; then
    echo "x11-wallpaper: no such directory: $dir" >&2
    urgency="normal"
    timeout=0
    notify "no such folder: $dir"
    reset_root
    exit 0
fi

# Only the top level, no dotfiles, images only. shuf picks uniformly at random.
wallpaper=$(find "$dir" -maxdepth 1 -type f -not -name '.*' \
    \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.bmp' \) \
    -print 2>/dev/null | shuf -n 1)

if [ -z "$wallpaper" ]; then
    count=$(find "$dir" -maxdepth 1 -type f -not -name '.*' 2>/dev/null | wc -l)
    echo "x11-wallpaper: no images in $dir ($count other file(s))" >&2
    urgency="normal"
    timeout=0
    if [ "$count" -gt 0 ]; then
        notify "no images in $dir (only $count other file(s))"
    else
        notify "no images in $dir"
    fi
    reset_root
    exit 0
fi

reset_root

if command -v feh >/dev/null && feh --bg-fill --no-fscreen "$wallpaper"; then
    notify "reset + $(basename "$wallpaper")"
else
    echo "x11-wallpaper: feh failed for $wallpaper" >&2
    exit 0
fi
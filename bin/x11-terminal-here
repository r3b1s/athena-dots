#!/bin/sh
# Open a kitty in the working directory of the focused kitty window.
#
# Asks the focused kitty (via its remote-control socket, set in kitty.conf)
# which directory its active window is in. Falls back to $HOME when the focused
# window is not kitty or anything fails.
set -eu

dir=
pid=$(xdotool getwindowfocus getwindowpid 2>/dev/null || true)

if [ -n "$pid" ] && [ "$(cat "/proc/$pid/comm" 2>/dev/null || true)" = kitty ]; then
    dir=$(kitty @ --to "unix:@kitty-$pid" ls 2>/dev/null | jq -r '
        (map(select(.is_focused)) + .)[0]
        | .tabs[] | select(.is_active)
        | .windows[] | select(.is_active)
        | .cwd' 2>/dev/null | head -n1) || dir=
fi

if [ -n "$dir" ] && [ -d "$dir" ]; then
    exec kitty --directory "$dir"
fi
exec kitty
